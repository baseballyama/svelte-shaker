{
  // Isolated declarations let tsdown's Oxc path generate and bundle the three
  // public type surfaces without publishing declarations for internal modules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "isolatedDeclarations": true,
    "noEmit": false,
    "rootDir": "./src"
  },
  "include": ["src"]
}
